APP_NAME=xflexy
ENVIRONMENT=local
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./xflexy.db

# Never commit real tokens. Copy this file to .env locally and fill test values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
FLEXY_PROVIDER=mock
ADMIN_API_KEY=change-me-local-admin-key
MIN_FLEXY_AMOUNT=50
MAX_FLEXY_AMOUNT=50000
PHONE_REGEX=^\+?[0-9]{8,15}$
MOCK_FLEXY_MODE=success
